<nav class="navbar bg-body-tertiary border-bottom">
  <div class="container-fluid flex-nowrap py-2">
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2 me-2 me-md-4 mb-0",
                aria: { label: t("app_name") } do %>
      <%= icon("box", size: 26) %>
      <span class="d-none d-sm-inline"><%= t("app_name") %></span>
    <% end %>

    <div class="d-none d-md-block flex-grow-1">
      <%= render "shared/search_form", input_id: "header-search" %>
    </div>

    <div class="d-flex align-items-center gap-2 ms-auto">
      <button class="btn btn-outline-secondary d-md-none" type="button" data-bs-toggle="collapse"
              data-bs-target="#mobile-search" aria-expanded="false" aria-controls="mobile-search"
              aria-label="<%= t("header.search") %>">
        <%= icon("search") %>
      </button>

      <div class="dropdown">
        <button class="btn btn-outline-secondary" type="button" data-bs-toggle="dropdown"
                aria-expanded="false" aria-label="<%= t("header.settings") %>" title="<%= t("header.settings") %>">
          <%= icon("gear") %>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><h6 class="dropdown-header"><%= t("header.settings") %></h6></li>
          <li><h6 class="dropdown-header py-1"><%= t("header.language") %></h6></li>
          <li>
            <%= button_to language_preference_path(locale: "en"), method: :patch,
                          class: "dropdown-item d-flex justify-content-between align-items-center #{'active' if I18n.locale == :en}" do %>
              <%= t("languages.en") %><%= icon("check") if I18n.locale == :en %>
            <% end %>
          </li>
          <li>
            <%= button_to language_preference_path(locale: "pl"), method: :patch,
                          class: "dropdown-item d-flex justify-content-between align-items-center #{'active' if I18n.locale == :pl}" do %>
              <%= t("languages.pl") %><%= icon("check") if I18n.locale == :pl %>
            <% end %>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <%= form_with url: theme_preference_path, method: :patch, local: true, data: { theme_form: true } do %>
              <%= hidden_field_tag :theme, current_theme %>
              <div class="form-check form-switch mx-3 my-1">
                <input class="form-check-input" type="checkbox" role="switch" id="theme-switch"
                       data-theme-switch <%= "checked" if current_theme == "dark" %>>
                <label class="form-check-label" for="theme-switch"><%= t("header.dark_mode") %></label>
              </div>
            <% end %>
          </li>
        </ul>
      </div>

      <% if user_signed_in? %>
        <div class="dropdown">
          <button class="btn btn-outline-secondary d-flex align-items-center gap-2" type="button"
                  data-bs-toggle="dropdown" aria-expanded="false">
            <%= icon("user") %>
            <span class="text-truncate"><%= truncate(current_user.name, length: 18) %></span>
            <%= icon("chevron-down", size: 14) %>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li class="px-3 py-1">
              <div class="fw-semibold"><%= current_user.name %></div>
              <div class="small text-body-secondary"><%= current_user.role_name %></div>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li><%= link_to t("header.profile"), user_path(current_user), class: "dropdown-item" %></li>
            <% if current_user.admin? %>
              <li><%= link_to t("header.admin_dashboard"), admin_path, class: "dropdown-item" %></li>
            <% end %>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= button_to t("header.log_out"), destroy_user_session_path, method: :delete,
                            class: "dropdown-item", form_class: "m-0" %>
            </li>
          </ul>
        </div>
      <% else %>
        <%= link_to t("header.log_in"), new_user_session_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="collapse d-md-none w-100" id="mobile-search">
    <div class="px-3 pb-3">
      <%= render "shared/search_form", input_id: "mobile-search-input" %>
    </div>
  </div>
</nav>
