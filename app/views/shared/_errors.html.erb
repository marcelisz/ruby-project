<% if object.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <p class="fw-semibold mb-2"><%= t("common.errors", count: object.errors.count) %></p>
    <ul class="mb-0">
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
