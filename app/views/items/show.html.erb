<% content_for :title, @item.custom_id %>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to @inventory.title, inventory_path(@inventory) %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @item.custom_id %></li>
  </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
  <h1 class="h2 mb-0"><%= @item.custom_id %></h1>
  <div class="d-flex flex-wrap align-items-center gap-2">
    <span class="badge text-bg-danger"><%= t("items.likes_count", count: @item.likes_count) %></span>
    <% if user_signed_in? %>
      <% if @liked %>
        <button class="btn btn-outline-danger" type="button" disabled><%= t("items.liked") %></button>
      <% else %>
        <%= button_to t("items.like"), inventory_item_like_path(@inventory, @item), method: :post,
                      class: "btn btn-outline-danger", form_class: "m-0" %>
      <% end %>
    <% end %>
    <% if @can_write && !@editing %>
      <%= link_to t("common.edit"), inventory_item_path(@inventory, @item, edit: 1), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<% if @editing %>
  <div class="card">
    <div class="card-body">
      <%= render "items/form", inventory: @inventory, item: @item, fields: @fields %>
    </div>
  </div>
<% else %>
  <div class="card">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3"><%= t("items.custom_id") %></dt>
        <dd class="col-sm-9"><code><%= @item.custom_id %></code></dd>

        <dt class="col-sm-3"><%= t("items.created_by") %></dt>
        <dd class="col-sm-9"><%= display_name(@item.created_by) %></dd>

        <dt class="col-sm-3"><%= t("items.created_at") %></dt>
        <dd class="col-sm-9"><%= l(@item.created_at, format: :long) %></dd>

        <% @fields.each do |field| %>
          <dt class="col-sm-3"><%= field.title %></dt>
          <dd class="col-sm-9"><%= field_value(field, @item.value_for(field), full: true, gallery: "inventory-#{@inventory.id}-item-#{@item.id}") %></dd>
        <% end %>
      </dl>
    </div>
  </div>
<% end %>

<div class="mt-3">
  <%= link_to t("items.back_to_inventory"), inventory_path(@inventory), class: "btn btn-outline-secondary" %>
</div>
