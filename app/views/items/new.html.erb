<% content_for :title, t("items.new_title") %>
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to @inventory.title, inventory_path(@inventory) %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= t("items.new_title") %></li>
  </ol>
</nav>
<h1 class="h2 mb-3"><%= t("items.new_title") %></h1>
<div class="card">
  <div class="card-body">
    <%= render "items/form", inventory: @inventory, item: @item, fields: @fields %>
  </div>
</div>
