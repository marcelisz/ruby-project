<% content_for :title, t("search.title") %>
<h1 class="h2 mb-1"><%= t("search.title") %></h1>
<p class="text-body-secondary mb-4"><%= t("search.results_for", query: @query) %></p>

<% if @documents.empty? %>
  <div class="alert alert-secondary"><%= t("search.no_results") %></div>
<% else %>
  <% if @inventories.any? %>
    <section class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center gap-3">
        <h2 class="h5 mb-0"><%= t("search.inventories") %></h2>
        <span class="badge text-bg-secondary"><%= @inventories.size %></span>
      </div>
      <%= render "search/inventory_results", inventories: @inventories %>
    </section>
  <% end %>

  <% if @items.any? %>
    <section class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center gap-3">
        <h2 class="h5 mb-0"><%= t("search.items") %></h2>
        <span class="badge text-bg-secondary"><%= @items.size %></span>
      </div>
      <div class="list-group list-group-flush">
        <% @items.each do |document| %>
          <% item = document.searchable %>
          <div class="list-group-item py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
              <%= link_to item.custom_id, inventory_item_path(item.inventory_id, item),
                          class: "fw-semibold link-body-emphasis" %>
              <span class="small text-body-secondary"><%= @item_contexts[item.inventory_id] %></span>
            </div>
            <% if document.body.present? %>
              <p class="mb-0 mt-1 small text-body-secondary"><%= truncate(document.body, length: 180) %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @users.any? %>
    <section class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center gap-3">
        <h2 class="h5 mb-0"><%= t("search.users") %></h2>
        <span class="badge text-bg-secondary"><%= @users.size %></span>
      </div>
      <div class="list-group list-group-flush">
        <% @users.each do |document| %>
          <% user = document.searchable %>
          <div class="list-group-item py-3">
            <%= link_to user.name, user_path(user), class: "fw-semibold link-body-emphasis" %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
