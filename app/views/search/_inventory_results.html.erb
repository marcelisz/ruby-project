<% if inventories.any? %>
  <div class="list-group list-group-flush">
    <% inventories.each do |inventory| %>
      <div class="list-group-item py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
          <div>
            <div class="fw-semibold">
              <%= link_to inventory.title, inventory_path(inventory), class: "link-body-emphasis" %>
            </div>
            <div class="small text-body-secondary">
              <%= inventory.category.name %> · <%= t("inventories.items_count_value", count: inventory.items_count) %>
              · <%= t("inventories.created_by") %> <%= inventory.creator.name %>
            </div>
          </div>
        </div>
        <% if inventory.description.present? %>
          <p class="mb-0 mt-1 text-body-secondary"><%= plain_markdown(inventory.description, length: 200) %></p>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card-body text-body-secondary"><%= t("common.none") %></div>
<% end %>
