<% content_for :title, "#{@inventory.title} · #{t('tabs.access')}" %>
<%= render "inventories/header", inventory: @inventory %>
<%= render "inventories/tabs", inventory: @inventory, active: :access %>

<div class="card mb-4">
  <div class="card-header"><h2 class="h5 mb-0"><%= t("access.public_title") %></h2></div>
  <div class="card-body">
    <%= form_with model: @inventory, url: access_inventory_path(@inventory), method: :patch, local: true do |f| %>
      <%= hidden_field_tag "inventory[lock_version]", @inventory.lock_version if @inventory.persisted? %>
      <div class="form-check form-switch mb-3">
        <%= f.check_box :public, class: "form-check-input", role: "switch" %>
        <%= f.label :public, t("access.public"), class: "form-check-label" %>
      </div>
      <p class="text-body-secondary"><%= t("access.public_hint") %></p>
      <%= f.submit t("common.save"), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header"><h2 class="h5 mb-0"><%= t("access.add_user") %></h2></div>
  <div class="card-body">
    <%= form_with url: access_inventory_path(@inventory), method: :post, local: true, class: "row g-2 align-items-end" do %>
      <div class="col-md-8">
        <%= label_tag :user_id, t("access.user"), class: "form-label" %>
        <%= select_tag :user_id, nil, include_blank: true, class: "form-select",
                       data: { user_select: true, url: user_autocomplete_inventory_path(@inventory),
                               placeholder: t("access.autocomplete_placeholder") } %>
      </div>
      <div class="col-md-4 d-flex align-items-end">
        <%= submit_tag t("common.add"), class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
  <h2 class="h5 mb-0"><%= t("access.list_title") %></h2>
  <div class="btn-group">
    <%= link_to t("access.sort_by_name"), access_inventory_path(@inventory, sort: "name"),
                class: "btn btn-sm #{@sort == 'name' ? 'btn-primary' : 'btn-outline-secondary'}" %>
    <%= link_to t("access.sort_by_email"), access_inventory_path(@inventory, sort: "email"),
                class: "btn btn-sm #{@sort == 'email' ? 'btn-primary' : 'btn-outline-secondary'}" %>
  </div>
</div>

<div class="card">
  <% if @accesses.any? %>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th scope="col"><%= t("access.name") %></th>
            <th scope="col"><%= t("access.email") %></th>
            <th scope="col" class="text-end"><%= t("access.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @accesses.each do |access| %>
            <tr>
              <td><%= link_to access.user.name, user_path(access.user) %></td>
              <td><%= access.user.email %></td>
              <td class="text-end">
                <%= button_to t("access.remove"), remove_access_inventory_path(@inventory, access.user_id),
                              method: :delete, class: "btn btn-sm btn-outline-danger", form_class: "d-inline",
                              form: { data: { confirm: t("access.remove_confirm") } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="card-body text-body-secondary"><%= t("access.empty") %></div>
  <% end %>
</div>
