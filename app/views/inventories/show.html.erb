<% content_for :title, @inventory.title %>
<%= render "inventories/header", inventory: @inventory %>
<%= render "inventories/tabs", inventory: @inventory, active: :items %>

<% if @can_write %>
  <%= form_with url: bulk_destroy_inventory_items_path(@inventory), method: :delete, local: true,
                html: { id: "bulk-items-form", data: { confirm: t("items.delete_confirm") } } do %><% end %>
<% end %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
  <p class="mb-0 text-body-secondary"><%= t("items.total", count: @inventory.items_count) %></p>
  <% if @can_write %>
    <div class="d-flex gap-2">
      <%= link_to new_inventory_item_path(@inventory), class: "btn btn-primary" do %>
        <%= icon("plus") %> <%= t("items.add") %>
      <% end %>
      <button class="btn btn-danger" type="submit" form="bulk-items-form" disabled
              data-bulk-delete>
        <%= icon("trash") %> <%= t("items.delete") %>
      </button>
    </div>
  <% end %>
</div>

<div class="card">
  <% if @items.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <% if @can_write %>
              <th scope="col">
                <input class="form-check-input" type="checkbox" id="select-all-items"
                       aria-label="<%= t("items.select_all") %>">
              </th>
            <% end %>
            <%= sortable_th t("items.custom_id"), "custom_id", current_sort: @item_sort, current_direction: @item_direction %>
            <% @table_fields.each do |field| %>
              <%= sortable_th field.title, "field_#{field.id}", current_sort: @item_sort, current_direction: @item_direction %>
            <% end %>
            <%= sortable_th t("items.likes"), "likes_count", current_sort: @item_sort, current_direction: @item_direction %>
          </tr>
        </thead>
        <tbody>
          <% @items.each do |item| %>
            <tr data-href="<%= inventory_item_path(@inventory, item) %>">
              <% if @can_write %>
                <td>
                  <input class="form-check-input js-item-checkbox" type="checkbox" name="item_ids[]"
                         value="<%= item.id %>" form="bulk-items-form" aria-label="<%= item.custom_id %>">
                </td>
              <% end %>
              <td><%= link_to item.custom_id, inventory_item_path(@inventory, item), class: "fw-semibold" %></td>
              <% @table_fields.each do |field| %>
                <td><%= field_value(field, item.value_for(field), gallery: "inventory-#{@inventory.id}-item-#{item.id}") %></td>
              <% end %>
              <td><%= item.likes_count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="card-body text-body-secondary"><%= t("items.empty") %></div>
  <% end %>
</div>
