<% content_for :title, "#{@inventory.title} · #{t('tabs.export')}" %>
<%= render "inventories/header", inventory: @inventory %>
<%= render "inventories/tabs", inventory: @inventory, active: :export %>

<div class="card">
  <div class="card-body">
    <h2 class="h4 mb-2"><%= t("export.title") %></h2>
    <p class="text-body-secondary"><%= t("export.intro") %></p>

    <div class="d-flex flex-wrap gap-2 mt-4">
      <%= link_to t("export.download_xlsx"), export_xlsx_inventory_path(@inventory),
                  class: "btn btn-primary" %>
      <%= link_to t("export.download_csv"), export_csv_inventory_path(@inventory),
                  class: "btn btn-outline-primary" %>
    </div>
  </div>
</div>
