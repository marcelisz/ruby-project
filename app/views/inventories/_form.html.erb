<% autosave = local_assigns.fetch(:autosave, false) %>
<% cloudinary_widget_script %>
<% form_data = autosave ? {
  autosave: true,
  autosave_url: inventory_path(inventory),
  autosave_interval: 8000,
  autosave_saving: t("autosave.saving"),
  autosave_saved: t("autosave.saved"),
  autosave_error: t("autosave.error"),
  autosave_conflict: t("autosave.conflict")
} : {} %>
<%= form_with model: inventory, local: true, html: { data: form_data } do |f| %>
  <%= hidden_field_tag "inventory[lock_version]", inventory.lock_version if inventory.persisted? %>
  <%= render "shared/errors", object: inventory %>
  <div class="mb-3">
    <%= f.label :title, t("inventories.title"), class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true, maxlength: 255 %>
  </div>
  <div class="mb-3">
    <%= f.label :description, t("inventories.description"), class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 5 %>
  </div>
  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :category_id, t("inventories.category"), class: "form-label" %>
      <%= f.collection_select :category_id, categories, :id, :name, { include_blank: true },
                              { class: "form-select", required: true } %>
    </div>
    <div class="col-md-6">
      <%= label_tag "inventory_tag_list", t("inventories.tags"), class: "form-label" %>
      <%= hidden_field_tag "inventory[tag_list][]", "" %>
      <%= select_tag "inventory[tag_list][]",
                     options_for_select(inventory.tags.map { |tag| [tag.name, tag.name] }, inventory.tag_list),
                     multiple: true, id: "inventory_tag_list", class: "form-select",
                     data: { tag_select: true, url: tags_autocomplete_path,
                             placeholder: t("inventories.tags_placeholder") } %>
    </div>
  </div>
  <div class="mb-3">
    <%= f.label :image_url, t("inventories.image"), class: "form-label" %>
    <div class="input-group">
      <%= f.url_field :image_url, class: "form-control", placeholder: "https://..." %>
      <%= cloudinary_upload_button(input_id: "inventory_image_url", preview_id: "inventory-image-preview") %>
    </div>
    <%= image_tag inventory.image_url.presence || CloudinaryHelper::TRANSPARENT_PIXEL,
                  alt: inventory.title, id: "inventory-image-preview",
                  class: "img-thumbnail mt-2 #{'d-none' unless inventory.image_url.present?}" %>
  </div>
  <div class="d-flex flex-wrap align-items-center gap-3">
    <%= f.submit inventory.persisted? ? t("common.save") : t("inventories.create"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), inventory.persisted? ? inventory_path(inventory) : inventories_path,
                class: "btn btn-outline-secondary" %>
    <% if autosave %>
      <span class="small text-body-secondary" data-autosave-status aria-live="polite"></span>
    <% end %>
  </div>
<% end %>
