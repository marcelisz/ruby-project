<% content_for :title, @inventory.title %>
<%= render "inventories/header", inventory: @inventory %>
<%= render "inventories/tabs", inventory: @inventory, active: :settings %>

<div class="card mb-4">
  <div class="card-header"><h2 class="h5 mb-0"><%= t("settings.title") %></h2></div>
  <div class="card-body">
    <%= render "inventories/form", inventory: @inventory, categories: @categories, autosave: true %>
  </div>
</div>

<div class="card border-danger">
  <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
      <h2 class="h5 mb-1"><%= t("settings.delete_title") %></h2>
      <p class="text-body-secondary mb-0"><%= t("settings.delete_hint") %></p>
    </div>
    <%= button_to t("settings.delete"), inventory_path(@inventory), method: :delete,
                  class: "btn btn-danger", form_class: "m-0",
                  form: { data: { confirm: t("settings.delete_confirm") } } %>
  </div>
</div>
